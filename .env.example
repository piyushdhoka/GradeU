# Teacher app (teacher branch). Server-only unless prefixed NEXT_PUBLIC_.

# Supabase: same project as the student site and admin
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MongoDB: same cluster as the student site (generation logs)
MONGODB_URI=

# Redis TCP URL for the BullMQ queue (Upstash → Connect → rediss://...), not the REST URL
REDIS_URL=

# Gemini: course content + embeddings. _1.._3 are optional extra keys rotated on rate limits
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Groq: optional, used when the generate page picks the Groq provider
GROQ_API_KEY=
